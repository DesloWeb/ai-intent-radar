# Copy this file to .env and fill in your values

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./radar.db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider — "mock" for local dev, "anthropic" for production
AI_PROVIDER=mock
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Security — generate strong random secrets for production
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000"]

# Enabled markets
ENABLED_COUNTRIES=["US"]

# Data source API keys
SAM_GOV_API_KEY=your-sam-gov-api-key-here

# Hacker News — no credentials needed, uses public Firebase API

# Email (Resend) — sends the brief link to matched providers on generation.
# Leave RESEND_API_KEY unset to skip sending; brief links still work, they
# just need to be shared manually (e.g. via the Contact modal).
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Intent Radar <notifications@yourdomain.com>

# Debug
DEBUG=false
