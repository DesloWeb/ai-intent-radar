# AI Intent Radar - Environment Variables for Docker
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Security - Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret
JWT_SECRET_KEY=change-me-generate-a-real-secret

# Database (internal Docker network)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/radar

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379/0

# AI Provider
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Frontend URL (for CORS)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
